private noncomputable def sourceIndex (i : Fin 256) : Fin 1024 :=
  T7ReducedIndexData.dentIndex (sourceBlock256 1 i)
private def chunkIndex (k : Fin 4) (j : Fin 64) : Fin 256 :=
  ⟨64 * k.val + j.val, by omega⟩

private theorem checkedChunk00 : allPairsB (fun (_ : Fin 1) (j : Fin 64) =>
    directMatchCheck (T7ReducedIndexData.bumpIndex 255)
      (sourceIndex (chunkIndex 0 j)) (rows (chunkIndex 0 j))) = true := by decide +kernel

private theorem checkedChunk01 : allPairsB (fun (_ : Fin 1) (j : Fin 64) =>
    directMatchCheck (T7ReducedIndexData.bumpIndex 255)
      (sourceIndex (chunkIndex 1 j)) (rows (chunkIndex 1 j))) = true := by decide +kernel

private theorem checkedChunk02 : allPairsB (fun (_ : Fin 1) (j : Fin 64) =>
    directMatchCheck (T7ReducedIndexData.bumpIndex 255)
      (sourceIndex (chunkIndex 2 j)) (rows (chunkIndex 2 j))) = true := by decide +kernel

private theorem checkedChunk03 : allPairsB (fun (_ : Fin 1) (j : Fin 64) =>
    directMatchCheck (T7ReducedIndexData.bumpIndex 255)
      (sourceIndex (chunkIndex 3 j)) (rows (chunkIndex 3 j))) = true := by decide +kernel

private theorem checkedChunks : ∀ k : Fin 4,
    allPairsB (fun (_ : Fin 1) (j : Fin 64) =>
      directMatchCheck (T7ReducedIndexData.bumpIndex 255)
        (sourceIndex (chunkIndex k j)) (rows (chunkIndex k j))) = true :=
  Fin.cases checkedChunk00 (Fin.cases checkedChunk01 (Fin.cases checkedChunk02 (Fin.cases checkedChunk03 (fun i => Fin.elim0 i))))

private theorem checked : allPairsB (fun (_ : Fin 1) (i : Fin 256) =>
    directMatchCheck (T7ReducedIndexData.bumpIndex 255) (sourceIndex i) (rows i)) = true := by
  apply List.all_eq_true.mpr
  intro _ _
  apply List.all_eq_true.mpr
  intro i _
  let k : Fin 4 := ⟨i.val / 64, by omega⟩
  let j : Fin 64 := ⟨i.val % 64, by omega⟩
  have hi : chunkIndex k j = i := by
    apply Fin.ext
    simp only [chunkIndex, k, j]
    omega
  have hc := allPairsB_sound (checkedChunks k) 0 j
  simpa only [hi] using hc
public theorem classified : BlockLaw256 255 1 := by
  intro i p asymmetric matched legal
  exact classify_from_match (allPairsB_sound checked 0 i) asymmetric p matched legal
