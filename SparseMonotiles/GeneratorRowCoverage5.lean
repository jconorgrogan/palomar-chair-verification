def allPairCertificates (a b : Fin 256) : GeneratorPairCertificate 5 ReplayAddress :=
  coverageChunkCertificates ⟨a.val / 2, by omega⟩ ⟨a.val % 2, by omega⟩ b
theorem allPairCertificates_checked (a b : Fin 256) :
    (allPairCertificates a b).Valid geometry.cells replayPoseLookup (generatorIndexing.pair a b) := by
  apply GeneratorPairCertificate.chairValid_valid cells_eq
  have h := coverageChunks_checked ⟨a.val / 2, by omega⟩ ⟨a.val % 2, by omega⟩ b
  have he : (⟨(a.val / 2) * 2 + a.val % 2, by omega⟩ : Fin 256) = a := by
    apply Fin.ext
    dsimp
    omega
  simpa only [allPairCertificates, he] using h
