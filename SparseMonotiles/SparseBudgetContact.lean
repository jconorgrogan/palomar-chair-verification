module
public import SparseMonotiles.SparseOuterCoordinates
@[expose] public section
namespace SparseMonotiles.CarrierHierarchy
open Contact

theorem coordinateGapCost_le_one_iff (x y : ℤ) :
    coordinateGapCost x y ≤ 1 ↔ ¬ ForwardGap x y 2 := by
  unfold coordinateGapCost ForwardGap
  omega

theorem coordinateGapCost_eq_zero_iff (x y : ℤ) :
    coordinateGapCost x y = 0 ↔ ¬ ForwardGap x y 1 := by
  unfold coordinateGapCost ForwardGap
  omega

/-- An all-dimension additive budget consequence of the geometric safe filter. -/
theorem forwardBoxSafe_gapCost_sum {d : ℕ} {p q : Pose d}
    (h : ForwardBoxSafe p q) :
    ((List.finRange d).map fun i => coordinateGapCost (boxLower p i) (boxLower q i)).sum ≤ 1 := by
  let f : Fin d → ℕ := fun i => coordinateGapCost (boxLower p i) (boxLower q i)
  have hbound : ∀ i, f i ≤ 1 := fun i =>
    (coordinateGapCost_le_one_iff _ _).mpr (h.1 i)
  have hunique : ∀ i j, 0 < f i → 0 < f j → i = j := by
    intro i j hi hj
    apply h.2 i j
    · by_contra hh
      have := (coordinateGapCost_eq_zero_iff (boxLower p i) (boxLower q i)).mpr hh
      change f i = 0 at this
      omega
    · by_contra hh
      have := (coordinateGapCost_eq_zero_iff (boxLower p j) (boxLower q j)).mpr hh
      change f j = 0 at this
      omega
  have hsum : ∀ xs : List (Fin d), xs.Nodup → (xs.map f).sum ≤ 1 := by
    intro xs hn
    induction xs with
    | nil => simp
    | cons a xs ih =>
      have hn' := List.nodup_cons.mp hn
      have ht := ih hn'.2
      by_cases ha : f a = 0
      · simpa [ha] using ht
      · have hz : xs.map f = xs.map (fun _ => 0) := by
          apply List.map_congr_left
          intro b hb
          have hne : a ≠ b := by intro hab; subst b; exact hn'.1 hb
          have : ¬ 0 < f b := fun hfb => hne (hunique a b (by omega) hfb)
          omega
        have haa := hbound a
        simp only [List.map_cons, List.sum_cons, hz]
        simpa using haa
  exact hsum _ (List.nodup_finRange d)

theorem cellContact_gapCost_sum {d : ℕ} {p q : Pose d} (h : CellContact p q) :
    ((List.finRange d).map fun i => coordinateGapCost (boxLower p i) (boxLower q i)).sum ≤ 1 :=
  forwardBoxSafe_gapCost_sum (cellContact_forwardBoxSafe h)

/-- Every contacting outer role is generated by seven (or d) independent
coordinate choices with total budget one, without a role-table scan. -/
theorem cellContact_refinedOuter_assignment_generated {d : ℕ}
    (root parent : Pose d) (a : Bits d) (σ : Equiv.Perm (Fin d))
    (hc : CellContact root (compose (dilatePose parent) (outerPose a σ))) :
    (List.finRange d).map (fun i => a (parent.perm i)) ∈
      BooleanBudget.generate ((List.finRange d).map (outerCoordinateCost root parent)) 1 :=
  refinedOuter_assignment_generated root parent a σ 1 (cellContact_gapCost_sum hc)

