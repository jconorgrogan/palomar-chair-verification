module
public import SparseMonotiles.T7IndexedReplayReduction
@[expose] public section
namespace SparseMonotiles
open Contact CarrierHierarchy ContactInverseReuse
set_option maxRecDepth 100000
set_option maxHeartbeats 2000000

/-- A legal literal contact contains an actual matched key pair. Its coefficient
reversal comes from literal-key equality, not from an arbitrary generator row. -/
theorem IndexedGeometry.legalContact_exists_matched_opposite_keys {d n : ℕ}
    {g : IndexedGeometry d n}
    (nonempty : ∀ i, (g.profile i).Nonempty)
    {p : Pose d} (legal : g.LegalContact p) :
    ∃ (i j : Fin n) (root source : BoxKey d),
      root ∈ g.profile i ∧ source ∈ g.profile j ∧
      Shared p (g.facet i) (g.facet j) ∧
      root.literal = p.key g.denominator source.literal ∧
      root.bump = !source.bump := by
  obtain ⟨i, j, shared⟩ := legal.2.1
  obtain ⟨root, hroot⟩ := nonempty i
  have hmem : root.literal ∈ (g.profile i).image BoxKey.literal :=
    Finset.mem_image.mpr ⟨root, hroot, rfl⟩
  rw [legal.2.2 i j shared] at hmem
  rcases Finset.mem_image.mp hmem with ⟨lit, hlit, heq⟩
  rcases Finset.mem_image.mp hlit with ⟨source, hsource, rfl⟩
  refine ⟨i, j, root, source, hroot, hsource, shared, heq.symm, ?_⟩
  exact congrArg VertexKey.bump heq.symm

/-- Turn an actual matched pair into the original flat-index generator equation. -/
theorem T7_indexed_pair_of_matched_keys {p : Pose 7} {i j : Fin 896}
    {root source : BoxKey 7}
    (hroot : root ∈ IndexedData7.geometry.profile i)
    (hsource : source ∈ IndexedData7.geometry.profile j)
    (shared : Shared p (IndexedData7.geometry.facet i) (IndexedData7.geometry.facet j))
    (literal : root.literal = p.key IndexedData7.geometry.denominator source.literal) :
    ∃ a b : Fin 1024,
      T7KeyIndexing.generatorIndexingT7.key a = root ∧
      T7KeyIndexing.generatorIndexingT7.key b = source ∧
      T7KeyIndexing.generatorIndexingT7.pair a b = some p := by
  have matched := BoxKey.eq_pose_of_literal_match
    (((profile7_checked i).2 root hroot).1)
    (((profile7_checked j).2 source hsource).1) shared literal
  have generated := pairPose_eq_some_of_match
    (by decide : IndexedData7.geometry.denominator ≠ 0)
    (((profile7_checked j).2 source hsource).2.1) shared matched
  obtain ⟨a, hai, har⟩ := T7KeyIndexing.generatorIndexingT7.covers hroot
  obtain ⟨b, hbj, hbs⟩ := T7KeyIndexing.generatorIndexingT7.covers hsource
  refine ⟨a, b, har, hbs, ?_⟩
  simpa only [KeyIndexing.pair, hai, hbj, har, hbs] using generated

/-- Every legal contact is generated by a bump-root/dent-source pair after
possibly exchanging the two tiles via exact pose inversion. No second shared
facet, double profile, or body symmetry is assumed. -/
theorem T7_legalContact_exists_bump_dent_pair_or_inverse {p : Pose 7}
    (legal : IndexedData7.geometry.LegalContact p) :
    ∃ a b : Fin 1024,
      (T7KeyIndexing.generatorIndexingT7.key a).bump = true ∧
      (T7KeyIndexing.generatorIndexingT7.key b).bump = false ∧
      (T7KeyIndexing.generatorIndexingT7.pair a b = some p ∨
       T7KeyIndexing.generatorIndexingT7.pair a b = some (inversePose p)) := by
  obtain ⟨i, j, root, source, hroot, hsource, shared, literal, polarity⟩ :=
    IndexedGeometry.legalContact_exists_matched_opposite_keys
      (fun i => (profile7_checked i).1) legal
  cases hr : root.bump with
  | false =>
      have hs : source.bump = true := by
        cases h : source.bump <;> simp_all
      have inverse_literal : source.literal =
          (inversePose p).key IndexedData7.geometry.denominator root.literal := by
        rw [literal, inversePose_key_key]
      obtain ⟨a, b, har, hbs, generated⟩ :=
        T7_indexed_pair_of_matched_keys hsource hroot (shared_inversePose shared) inverse_literal
      exact ⟨a, b, by rw [har]; exact hs, by rw [hbs]; exact hr, Or.inr generated⟩
  | true =>
      have hs : source.bump = false := by
        cases h : source.bump <;> simp_all
      obtain ⟨a, b, har, hbs, generated⟩ :=
        T7_indexed_pair_of_matched_keys hroot hsource shared literal
      exact ⟨a, b, by rw [har]; exact hr, by rw [hbs]; exact hs, Or.inl generated⟩

/-- The replay obligation can be restricted to bump-root/dent-source pairs.
It remains an explicit hypothesis until every such indexed pair is checked. -/
theorem T7_contact_mem_M7_of_bump_dent_pair_classifications
    (hpairs : ∀ (a b : Fin 1024) (p : Pose 7),
      (T7KeyIndexing.generatorIndexingT7.key a).bump = true →
      (T7KeyIndexing.generatorIndexingT7.key b).bump = false →
      T7KeyIndexing.generatorIndexingT7.pair a b = some p →
      IndexedData7.geometry.LegalContact p → p ∈ M7)
    {p : Pose 7} (legal : IndexedData7.geometry.LegalContact p) : p ∈ M7 := by
  obtain ⟨a, b, ha, hb, generated⟩ := T7_legalContact_exists_bump_dent_pair_or_inverse legal
  rcases generated with generated | generated
  · exact hpairs a b p ha hb generated legal
  · exact (M7_inversePose_iff p).mpr
      (hpairs a b (inversePose p) ha hb generated (legalContact_inversePose legal))

#print axioms IndexedGeometry.legalContact_exists_matched_opposite_keys
#print axioms T7_indexed_pair_of_matched_keys
#print axioms T7_legalContact_exists_bump_dent_pair_or_inverse
#print axioms T7_contact_mem_M7_of_bump_dent_pair_classifications
end SparseMonotiles
