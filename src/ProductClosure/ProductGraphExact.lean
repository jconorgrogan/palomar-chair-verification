module

public import ProductClosure.ProductGraphBinding
public import ProductClosure.ProductGraphCommonExclusions

@[expose] public section

/-!
# Exact actual product contact graph and coefficient pullback

The graph is the literal generalized NativeCompiler.contactGraph generated by
actual block-lifted Euclidean isometries. Its decomposition is proved from
native geometry. All coefficient equations use the existing finite component
rank times determinant-orientation assignment, with arbitrary site orderings.
-/
namespace ProductClosure.ProductGraphExact
noncomputable section
open NativeCompiler PhysicalRegistration.ComponentCoefficients
open ProductGraph ProductGraphOrbit ProductGraphOrientation ProductGraphSites ProductGraphPlacements
open ProductGraphRightSites ProductGraphSiteCoproduct ProductGraphBinding
open ProductGraphExclusions ProductGraphCommonExclusions
attribute [local instance] Classical.propDecidable
variable {a b : ℕ}
variable {SA : Finset (Polycube.LatticeIndex (a+1))}
    {SB : Finset (Polycube.LatticeIndex (b+1))}

def productLanguage (A : Finset (Space a ≃ᵢ Space a)) (B : Finset (Space b ≃ᵢ Space b)) :
    Finset (Space (a+(b+1)) ≃ᵢ Space (a+(b+1))) :=
  leftLanguage A ∪ B.image commonLiftRight

theorem productLanguage_proper (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g) :
    ∀ g ∈ productLanguage A B, IsProperPlacement g := by
  intro g hmem
  rcases Finset.mem_union.mp hmem with hleft | hright
  · exact leftLanguage_proper A hA g hleft
  · obtain ⟨g,hg,rfl⟩ := Finset.mem_image.mp hright
    exact commonLiftRight_proper g (hB g hg)

def actualProductGraph (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g) :
    SimpleGraph (Site (nativeProduct SA SB)) :=
  contactGraph (productLanguage A B) (productLanguage_proper A B hA hB)

theorem actual_adj_left (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SA) (c d : Polycube.Cell SB) (p q : Passive a (b+1)) :
    (actualProductGraph A B hA hB).Adj (leftSite u c p) (leftSite v d q) ↔
      (contactGraph A hA).Adj u v ∧ c = d ∧ p = q := by
  constructor
  · rintro ⟨g,hmem,ht⟩
    rcases Finset.mem_union.mp hmem with hleft | hright
    · exact (contactGraph_left_left A hA u v c d p q).mp ⟨g,hleft,ht⟩
    · obtain ⟨g,hg,rfl⟩ := Finset.mem_image.mp hright
      exact (ht.elim (no_right_transport_left_left g u v c d p q)
        (no_right_transport_left_left g v u d c q p)).elim
  · intro h
    obtain ⟨g,hg,ht⟩ := (contactGraph_left_left A hA u v c d p q).mpr h
    exact ⟨g,Finset.mem_union_left _ hg,ht⟩

theorem actual_adj_right (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SB) (c d : Polycube.Cell SA) (p q : Passive b (a+1)) :
    (actualProductGraph A B hA hB).Adj (commonRightSite u c p) (commonRightSite v d q) ↔
      (contactGraph B hB).Adj u v ∧ c = d ∧ p = q := by
  constructor
  · rintro ⟨g,hmem,ht⟩
    rcases Finset.mem_union.mp hmem with hleft | hright
    · have he := contactGraph_no_left_right_right A hA c d u.1 v.1
        (rightCommonFrameEquiv (u.2,p)) (rightCommonFrameEquiv (v.2,q))
      exact (he ⟨g,hleft,by simpa only [commonRightSite_eq_rightRawSite] using ht⟩).elim
    · obtain ⟨g,hg,rfl⟩ := Finset.mem_image.mp hright
      rcases ht with ht | ht
      · obtain ⟨h,hc,hp⟩ := (SiteTransport_commonLiftRight_iff g u v c d p q).mp ht
        exact ⟨⟨g,hg,Or.inl h⟩,hc,hp⟩
      · obtain ⟨h,hc,hp⟩ := (SiteTransport_commonLiftRight_iff g v u d c q p).mp ht
        exact ⟨⟨g,hg,Or.inr h⟩,hc.symm,hp.symm⟩
  · rintro ⟨⟨g,hg,ht⟩,rfl,rfl⟩
    refine ⟨commonLiftRight g,Finset.mem_union_right _ (Finset.mem_image.mpr ⟨g,hg,rfl⟩),?_⟩
    exact ht.elim
      (fun h => Or.inl ((SiteTransport_commonLiftRight_iff g u v c c p p).mpr ⟨h,rfl,rfl⟩))
      (fun h => Or.inr ((SiteTransport_commonLiftRight_iff g v u c c p p).mpr ⟨h,rfl,rfl⟩))

theorem actual_no_cross (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u : Site SA) (c : Polycube.Cell SB) (p : Passive a (b+1))
    (v : Site SB) (d : Polycube.Cell SA) (q : Passive b (a+1)) :
    ¬(actualProductGraph A B hA hB).Adj (leftSite u c p) (commonRightSite v d q) := by
  rintro ⟨g,hmem,ht⟩
  rcases Finset.mem_union.mp hmem with hleft | hright
  · apply contactGraph_no_left_cross A hA u c p d v.1 (rightCommonFrameEquiv (v.2,q))
    exact ⟨g,hleft,by simpa only [commonRightSite_eq_rightRawSite] using ht⟩
  · obtain ⟨g,hg,rfl⟩ := Finset.mem_image.mp hright
    exact ht.elim (no_right_transport_left_right g u c p v d q)
      (no_right_transport_right_left g u c p v d q)

/-- Literal graph decomposition, derived from the physical native site and
placement definitions. Both factor types and every full orbit coset occur. -/
def actualGraphIso (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g) :
    productGraph (contactGraph (S := SA) A hA) (contactGraph (S := SB) B hB)
      (Polycube.Cell SB × Passive a (b+1)) (Polycube.Cell SA × Passive b (a+1)) ≃g
        actualProductGraph (SA := SA) (SB := SB) A B hA hB where
  toEquiv := siteCoproductEquiv SA SB
  map_rel_iff' := by
    rintro (⟨u,c,p⟩ | ⟨u,c,p⟩) (⟨v,d,q⟩ | ⟨v,d,q⟩)
    · simp only [siteCoproductEquiv_left, actual_adj_left]
      change (_ ∧ c = d ∧ p = q) ↔ (_ ∧ (c,p) = (d,q))
      simp
    · simp only [siteCoproductEquiv_left, siteCoproductEquiv_right]
      exact iff_false_intro (actual_no_cross A B hA hB u c p v d q)
    · simp only [siteCoproductEquiv_left, siteCoproductEquiv_right]
      refine iff_false_intro ?_
      intro h
      exact actual_no_cross A B hA hB v d q u c p h.symm
    · simp only [siteCoproductEquiv_right, actual_adj_right]
      change (_ ∧ c = d ∧ p = q) ↔ (_ ∧ (c,p) = (d,q))
      simp

/-- Opposite coefficients in the actual full graph recover the exact active
factor component and equal passive labels, independent of global numbering. -/
theorem actual_reachable_left (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SA) (c d : Polycube.Cell SB) (p q : Passive a (b+1)) :
    (actualProductGraph A B hA hB).Reachable (leftSite u c p) (leftSite v d q) ↔
      (contactGraph A hA).Reachable u v ∧ c = d ∧ p = q := by
  have h := @SimpleGraph.Iso.reachable_iff _ _ _ _ (actualGraphIso (SA := SA) (SB := SB) A B hA hB)
    (.inl (u,c,p)) (.inl (v,d,q))
  change (actualProductGraph A B hA hB).Reachable (leftSite u c p) (leftSite v d q) ↔ _ at h
  rw [h, product_reachable_left]
  simp

theorem actual_reachable_right (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SB) (c d : Polycube.Cell SA) (p q : Passive b (a+1)) :
    (actualProductGraph A B hA hB).Reachable (commonRightSite u c p) (commonRightSite v d q) ↔
      (contactGraph B hB).Reachable u v ∧ c = d ∧ p = q := by
  have h := @SimpleGraph.Iso.reachable_iff _ _ _ _ (actualGraphIso (SA := SA) (SB := SB) A B hA hB)
    (.inr (u,c,p)) (.inr (v,d,q))
  change (actualProductGraph A B hA hB).Reachable
    (siteCoproductEquiv SA SB (.inr (u,c,p))) (siteCoproductEquiv SA SB (.inr (v,d,q))) ↔ _ at h
  rw [siteCoproductEquiv_right, siteCoproductEquiv_right, product_reachable_right] at h
  simpa only [Prod.mk.injEq] using h

variable [LinearOrder (Site SA)] [LinearOrder (Site SB)] [LinearOrder (Site (nativeProduct SA SB))]

theorem actual_value_left_iff (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SA) (c d : Polycube.Cell SB) (p q : Passive a (b+1)) :
    value (actualProductGraph A B hA hB) orientation (leftSite v d q) =
      -value (actualProductGraph A B hA hB) orientation (leftSite u c p) ↔
    c = d ∧ p = q ∧ value (contactGraph A hA) orientation v =
      -value (contactGraph A hA) orientation u := by
  rw [opposite_value_iff _ _ orientation_sign, actual_reachable_left,
    leftSite_orientation, leftSite_orientation, opposite_value_iff _ _ orientation_sign]
  constructor
  · rintro ⟨⟨hc,hd,hp⟩,hs⟩
    refine ⟨hd,hp,hc,?_⟩
    rw [← hp] at hs
    rcases passiveOrientation_sign p with he | he <;> simp [he] at hs <;> omega
  · rintro ⟨hd,hp,hc,hs⟩
    refine ⟨⟨hc,hd,hp⟩,?_⟩
    simp [hp,hs]

theorem actual_value_right_iff (A : Finset (Space a ≃ᵢ Space a))
    (B : Finset (Space b ≃ᵢ Space b))
    (hA : ∀ g ∈ A, IsProperPlacement g) (hB : ∀ g ∈ B, IsProperPlacement g)
    (u v : Site SB) (c d : Polycube.Cell SA) (p q : Passive b (a+1)) :
    value (actualProductGraph A B hA hB) orientation (commonRightSite v d q) =
      -value (actualProductGraph A B hA hB) orientation (commonRightSite u c p) ↔
    c = d ∧ p = q ∧ value (contactGraph B hB) orientation v =
      -value (contactGraph B hB) orientation u := by
  rw [opposite_value_iff _ _ orientation_sign, actual_reachable_right,
    commonRightSite_orientation, commonRightSite_orientation, opposite_value_iff _ _ orientation_sign]
  constructor
  · rintro ⟨⟨hc,hd,hp⟩,hs⟩
    refine ⟨hd,hp,hc,?_⟩
    rw [← hp] at hs
    rcases rightPassiveOrientation_sign p with he | he <;> simp [he] at hs <;> omega
  · rintro ⟨hd,hp,hc,hs⟩
    refine ⟨⟨hc,hd,hp⟩,?_⟩
    simp [hp,hs]

#print axioms actualGraphIso
#print axioms actual_value_left_iff
#print axioms actual_value_right_iff
end
end ProductClosure.ProductGraphExact
