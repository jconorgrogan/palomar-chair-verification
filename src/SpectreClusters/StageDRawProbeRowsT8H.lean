theorem probeSuffixT8H_covered (w : List Nat) (hw : w ∈ probeSuffixT8H15) :
    ∃ i, i < (rawNeighborIDs .t8h).length ∧
      ∀ j ∈ (rawNeighborIDs .t8h).getD i [], j ∈ w := by
  rw [←probeRowWitnessesT8H_words] at hw
  obtain ⟨⟨word,i⟩,hm,he⟩ := List.mem_map.mp hw
  change word = w at he
  obtain ⟨hi,hrow⟩ := wordCoversRowB_sound .t8h word i
    (List.all_eq_true.mp probeRowWitnessesT8H_checked (word,i) hm)
  exact ⟨i,hi,by simpa only [he] using hrow⟩
