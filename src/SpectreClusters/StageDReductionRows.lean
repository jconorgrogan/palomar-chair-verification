def compactAt (k : ClusterKind) (n : Nat) : ClusterPlacement :=
  (compactCandidates k).getD n (canonical .t7h)

def compactIDs (k : ClusterKind) (i : Nat) : List Nat :=
  (compactRowIDs k).getD i []

def compactPatch (k : ClusterKind) (i : Nat) : List ClusterPlacement :=
  canonical k :: (compactIDs k i).map (compactAt k)

def compactMovedPatch (k : ClusterKind) (i : Nat) (p : ClusterPlacement) : List ClusterPlacement :=
  (compactPatch k i).map (moveClusterPlacement p.turn p.center)

def Captures (kept : ClusterKind → List Nat) : Prop :=
  ∀ (f : Cell → ClusterPlacement), ValidClusterGridField f →
    ∀ (root : ClusterPlacement), ClusterRootOwned f root → LegalClusterKind root.kind →
      ∃ i ∈ kept root.kind, ClusterPatchOwned f (compactMovedPatch root.kind i root)

