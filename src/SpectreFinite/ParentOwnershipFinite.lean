theorem certifiedParentRows_property : ∀ row ∈ certifiedParentRows, RowProperty row := by
  intro row hr
  obtain ⟨chunk,hc,hr⟩ := List.mem_flatten.mp hr
  exact certifiedParentChunks_property chunk hc row hr

theorem certifiedParentRows_count : certifiedParentRows.length = 2112 := by
  rw [certifiedParentRows, List.length_flatten]
  change (List.replicate 132 (16 : Nat)).sum = 2112
  rw [List.sum_replicate_nat]

theorem certifiedParentFamily_count : certifiedParentFamily.length = 2112 := by
  rw [certifiedParentFamily,List.length_map,certifiedParentRows_count]

theorem certifiedParentFamily_unique : ∀ p ∈ certifiedParentFamily,
    UniqueAt (patchState p) (0,0) := by
  intro p hp
  obtain ⟨row,hr,rfl⟩ := List.mem_map.mp hp
  exact rowProperty_unique row (certifiedParentRows_property row hr)

theorem certifiedParentFamily_shape : ∀ p ∈ certifiedParentFamily,
    patchState p (0,0) = (0,0) → ListedRootParent (patchState p) := by
  intro p hp
  obtain ⟨row,hr,rfl⟩ := List.mem_map.mp hp
  exact rowProperty_shape row (certifiedParentRows_property row hr)

/-- Conditional only: the missing occurrence theorem is visible in the type. -/
theorem unique_ownership_of_certifiedParentFamily (f : Position → State)
    (hocc : OccurrenceComplete f (hexRegion 5) certifiedParentFamily) :
    ∀ x : Position, UniqueAt f x :=
  unique_ownership_of_radiusFive_certificate certifiedParentFamily
    certifiedParentFamily_unique f hocc

/-- Conditional complete parent pattern for every turn-zero Gamma anchor. -/
theorem listed_parent_of_certifiedParentFamily (f : Position → State)
    (hocc : OccurrenceComplete f (hexRegion 5) certifiedParentFamily)
    (center : Position) (hroot : f center = (0,0)) :
    ListedRootParent (shiftedField f center) :=
  listed_parent_of_radiusFive_certificate certifiedParentFamily
    certifiedParentFamily_shape f hocc center hroot

