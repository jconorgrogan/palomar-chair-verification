theorem positions_eq_hexRegion : (List.finRange 91).map positions = hexRegion 5 := by decide
def constraints : List (Constraint 91 State) :=
  windowConstraints positions (hexRegion 4) RadiusFourPruning.certifiedFamily (hexRegion 5)
def domains (root : State) : Domains 91 State := rootDomains positions root
theorem covers_of_branches (D : Domains 91 State) (outs : List (List State))
    (v : Fin 91) (h : ∀ s ∈ D v, Covers (restrict D v s) constraints outs) :
    Covers D constraints outs := by
  intro f hf
  exact h (f v) (hf.1 v) f ⟨fits_restrict D f hf.1 v, hf.2⟩
end SpectreFinite.HexSearch.RadiusFive
