theorem target_boundary_path_bound : ∀ k : Fin 9, ∀ d : Fin 6,
    (boundaryIndices k d).map (targetVertex k) =
      ((SpectreClusters.ReverseExistence.markedPaths k).getD d.val []).map (scalePoint 6) := by
  exact Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (fun i => Fin.elim0 i)))))))))

def boundaryLinearCheck (k : Fin 9) (d : Fin 6) : Prop :=
  let ids := boundaryIndices k d
  1 < ids.length ∧ ∀ j ∈ List.range ids.length,
    let n : Int := ids.length-1
    let p := sourceVertex k (ids.getD j 0)
    let a := hexCorners.getD d.val (0,0)
    let b := hexCorners.getD ((d.val+1)%6) (0,0)
    n*p.1 = (sourceScale k : Int)*((n-j)*a.1+j*b.1) ∧
      n*p.2 = (sourceScale k : Int)*((n-j)*a.2+j*b.2)
instance (k : Fin 9) (d : Fin 6) : Decidable (boundaryLinearCheck k d) :=
  inferInstanceAs (Decidable (_ ∧ _))

theorem all_boundary_linear_checks : ∀ k : Fin 9, ∀ d : Fin 6, boundaryLinearCheck k d := by
  exact Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (fun i => Fin.elim0 i)))))))))

theorem all_source_scales_positive : ∀ k : Fin 9, 0 < sourceScale k := by decide

