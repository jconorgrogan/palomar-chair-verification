  (if big then rawStarValues1 else rawStarValues0).getD v []
def fastLocalStar (a : State) (v : Nat) : List (List Point) :=
  (rawStarValue (a.1.val != 0) v).map (fun t => t.map (SpectreClusters.rotate a.2))
def sideFastB (a b : State) (d : Fin 6) (j : Nat) : Bool :=
  let ids := stateBoundaryIds a d
  let ids' := stateBoundaryIds b (opposite d)
  occurrenceStructuralB (fastLocalStar a (ids.getD j 0) ++ fastLocalStar b (ids'.getD (ids'.length-1-j) 0))
    (sideCode a b d j)
def tripleFastB (a b c : State) (d : Fin 6) : Bool :=
  occurrenceStructuralB (fastLocalStar a ((stateBoundaryIds a d).getLastD 0) ++
    fastLocalStar b ((stateBoundaryIds b (opposite d)).headD 0) ++
    fastLocalStar c ((stateBoundaryIds c (rotateTurn 4 (rotateTurn 1 d))).headD 0))
    (tripleCode a b c d)
def SideFastCertificate (a : State) : Prop := ∀ (bk : Fin 9) (br d : Fin 6) (j : Fin 12),
  sideMatch a (bk,br) d → 0<j.val → j.val+1<(stateBoundaryIds a d).length →
    sideFastB a (bk,br) d j.val = true
def TripleFastCertificate (a : State) : Prop := ∀ (bk : Fin 9) (br : Fin 6) (ck : Fin 9) (cr d : Fin 6),
  sideMatch a (bk,br) d → sideMatch a (ck,cr) (rotateTurn 1 d) →
    sideMatch (bk,br) (ck,cr) (rotateTurn 2 d) → tripleFastB a (bk,br) (ck,cr) d = true

def RawStarBinding (big : Bool) (v : Nat) : Prop :=
  v < (targetVertices (if big then 1 else 0)).length →
    rawStarValue big v = localStar ((if big then 1 else 0),0) v
