  exact Fin.cases edge_incidence_1_192 (Fin.cases edge_incidence_1_193 (Fin.cases edge_incidence_1_194 (Fin.cases edge_incidence_1_195 (Fin.cases edge_incidence_1_196 (Fin.cases edge_incidence_1_197 (Fin.cases edge_incidence_1_198 (Fin.cases edge_incidence_1_199 (Fin.cases edge_incidence_1_200 (Fin.cases edge_incidence_1_201 (Fin.cases edge_incidence_1_202 (Fin.cases edge_incidence_1_203 (Fin.cases edge_incidence_1_204 (Fin.cases edge_incidence_1_205 (Fin.cases edge_incidence_1_206 (Fin.cases edge_incidence_1_207 ((fun i => Fin.elim0 i)))))))))))))))))

theorem edge_incidence_certificates_block_1_13 : ∀ i : Fin 16,
    EdgeIncidenceCertificate true (208+i.val) := by
  exact Fin.cases edge_incidence_1_208 (Fin.cases edge_incidence_1_209 (Fin.cases edge_incidence_1_210 (Fin.cases edge_incidence_1_211 (Fin.cases edge_incidence_1_212 (Fin.cases edge_incidence_1_213 (Fin.cases edge_incidence_1_214 (Fin.cases edge_incidence_1_215 (Fin.cases edge_incidence_1_216 (Fin.cases edge_incidence_1_217 (Fin.cases edge_incidence_1_218 (Fin.cases edge_incidence_1_219 (Fin.cases edge_incidence_1_220 (Fin.cases edge_incidence_1_221 (Fin.cases edge_incidence_1_222 (Fin.cases edge_incidence_1_223 ((fun i => Fin.elim0 i)))))))))))))))))

theorem edge_incidence_certificates_bounded_true : ∀ i : Fin 224, EdgeIncidenceCertificate true i.val := by
  intro i
  by_cases h0 : i.val < 16
  · simpa only [Nat.zero_add] using edge_incidence_certificates_block_1_0 ⟨i.val,by omega⟩
  by_cases h1 : i.val < 32
  · have hs : 16 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_1 ⟨i.val-16,by omega⟩
  by_cases h2 : i.val < 48
  · have hs : 32 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_2 ⟨i.val-32,by omega⟩
  by_cases h3 : i.val < 64
  · have hs : 48 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_3 ⟨i.val-48,by omega⟩
  by_cases h4 : i.val < 80
  · have hs : 64 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_4 ⟨i.val-64,by omega⟩
  by_cases h5 : i.val < 96
  · have hs : 80 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_5 ⟨i.val-80,by omega⟩
  by_cases h6 : i.val < 112
  · have hs : 96 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_6 ⟨i.val-96,by omega⟩
  by_cases h7 : i.val < 128
  · have hs : 112 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_7 ⟨i.val-112,by omega⟩
  by_cases h8 : i.val < 144
  · have hs : 128 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_8 ⟨i.val-128,by omega⟩
  by_cases h9 : i.val < 160
  · have hs : 144 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_9 ⟨i.val-144,by omega⟩
  by_cases h10 : i.val < 176
  · have hs : 160 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_10 ⟨i.val-160,by omega⟩
  by_cases h11 : i.val < 192
  · have hs : 176 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_11 ⟨i.val-176,by omega⟩
  by_cases h12 : i.val < 208
  · have hs : 192 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_12 ⟨i.val-192,by omega⟩
  have hs : 208 ≤ i.val := by omega
  simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_1_13 ⟨i.val-208,by omega⟩

theorem all_edge_incidence_certificates : ∀ (big : Bool) (i : Nat), EdgeIncidenceCertificate big i := by
  intro big i
  cases big with
  | false =>
    intro hi
    have hn : i < 224 := by
      change i < 208 at hi
      omega
    exact edge_incidence_certificates_bounded_false ⟨i,hn⟩ hi
  | true =>
    intro hi
    have hn : i < 224 := by
      change i < 218 at hi
      omega
    exact edge_incidence_certificates_bounded_true ⟨i,hn⟩ hi

end SpectreGeometry.ReverseMeshEdgeIncidence
