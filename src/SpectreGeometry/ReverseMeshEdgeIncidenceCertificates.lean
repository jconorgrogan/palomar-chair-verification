theorem edge_incidence_certificates_bounded_false : ∀ i : Fin 224, EdgeIncidenceCertificate false i.val := by
  intro i
  by_cases h0 : i.val < 16
  · simpa only [Nat.zero_add] using edge_incidence_certificates_block_0_0 ⟨i.val,by omega⟩
  by_cases h1 : i.val < 32
  · have hs : 16 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_1 ⟨i.val-16,by omega⟩
  by_cases h2 : i.val < 48
  · have hs : 32 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_2 ⟨i.val-32,by omega⟩
  by_cases h3 : i.val < 64
  · have hs : 48 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_3 ⟨i.val-48,by omega⟩
  by_cases h4 : i.val < 80
  · have hs : 64 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_4 ⟨i.val-64,by omega⟩
  by_cases h5 : i.val < 96
  · have hs : 80 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_5 ⟨i.val-80,by omega⟩
  by_cases h6 : i.val < 112
  · have hs : 96 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_6 ⟨i.val-96,by omega⟩
  by_cases h7 : i.val < 128
  · have hs : 112 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_7 ⟨i.val-112,by omega⟩
  by_cases h8 : i.val < 144
  · have hs : 128 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_8 ⟨i.val-128,by omega⟩
  by_cases h9 : i.val < 160
  · have hs : 144 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_9 ⟨i.val-144,by omega⟩
  by_cases h10 : i.val < 176
  · have hs : 160 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_10 ⟨i.val-160,by omega⟩
  by_cases h11 : i.val < 192
  · have hs : 176 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_11 ⟨i.val-176,by omega⟩
  by_cases h12 : i.val < 208
  · have hs : 192 ≤ i.val := by omega
    simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_12 ⟨i.val-192,by omega⟩
  have hs : 208 ≤ i.val := by omega
  simpa only [Nat.add_sub_of_le hs] using edge_incidence_certificates_block_0_13 ⟨i.val-208,by omega⟩

