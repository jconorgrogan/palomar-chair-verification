def kindMark (big : Bool) : Fin 9 := if big then 1 else 0
def boundarySize (big : Bool) : Nat := if big then 46 else 44
def otherTriangle (big : Bool) (i e : Nat) : Nat :=
  (((if big then otherRows1 else otherRows0).getD i []).getD e 999)
def edgeVertex (big : Bool) (i e : Nat) : Nat :=
  (triangleIndices ((meshTriangles (kindMark big)).getD i (0,0,0))).getD (e%3) 0

def EdgeIncidenceCertificate (big : Bool) (i : Nat) : Prop :=
  i < (meshTriangles (kindMark big)).length → ∀ e : Fin 3,
    let a := edgeVertex big i e.val
    let b := edgeVertex big i (e.val+1)
    let j := otherTriangle big i e.val
    (j < (meshTriangles (kindMark big)).length ∧ j ≠ i ∧
      a ∈ triangleIndices ((meshTriangles (kindMark big)).getD j (0,0,0)) ∧
      b ∈ triangleIndices ((meshTriangles (kindMark big)).getD j (0,0,0))) ∨
    (a < boundarySize big ∧ b < boundarySize big ∧
      ((a+1)%boundarySize big=b ∨ (b+1)%boundarySize big=a))

def BoundaryEdgeCertificate (k : Fin 9) (i : Nat) : Prop :=
  i < boundarySize (k.val != 0) →
    let w := ((boundaryEdgeRows.getD k.val []).getD i (0,0))
    w.1 < 6 ∧ w.2+1 < (boundaryIndices k ⟨w.1%6,Nat.mod_lt _ (by decide)⟩).length ∧
    (boundaryIndices k ⟨w.1%6,Nat.mod_lt _ (by decide)⟩).getD w.2 0 = i ∧
    (boundaryIndices k ⟨w.1%6,Nat.mod_lt _ (by decide)⟩).getD (w.2+1) 0 =
      (i+1)%boundarySize (k.val != 0)
end SpectreGeometry.ReverseMeshEdgeIncidence
