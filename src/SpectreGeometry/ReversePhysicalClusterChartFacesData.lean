def rawChartVertices (big : Bool) (n : Nat) (i : Fin 12) : List SpectreClusters.Point :=
  let p := (pieces big).getD n ⟨.turtle,0,(0,0)⟩
  [rawPlacedVertex p (physicalIndex p.kind (triangle i).1),
   rawPlacedVertex p (physicalIndex p.kind (triangle i).2.2),
   rawPlacedVertex p (physicalIndex p.kind (triangle i).2.1)]

theorem chartFamily_length : ∀ big : Bool, (chartFamily big).length = 12*(pieces big).length := by
  intro big; cases big <;> decide

def ChartPacketBinding (big : Bool) (z : Nat) : Prop :=
  packetCheckedB ((chartFamily big).getD z default) = true ∧
    ((chartFamily big).getD z default).vertices =
      rawChartVertices big (z/12) ⟨z%12,Nat.mod_lt _ (by decide)⟩

def ChartFaceRowCheck (big : Bool) (z : Nat) : Prop :=
  packetFaceRowB ((chartFamily big).getD z default) ((chartFamily big).take z)
    ((chartFaceRows big).getD z []) = true
end SpectreGeometry.ReversePhysicalClusterCharts
