def pieces (big : Bool) : List HTPlacement := clusterPieces (if big then .t8h else .t7h)
def vertexPairs (big : Bool) : List (SpectreClusters.Point × ExactPoint) :=
  if big then vertexPairsT8H else vertexPairsT7H
def origins (big : Bool) : List ExactPoint := if big then originsT8H else originsT7H
def vertexImage4 (big : Bool) (p : SpectreClusters.Point) : ExactPoint :=
  (((vertexPairs big).find? (fun q => q.1 == p)).map Prod.snd).getD ((0,0),(0,0))
def physicalTurn (p : HTPlacement) : Fin 12 :=
  ⟨(24-2*p.turn.val+(if p.kind == .hat then 1 else 0))%12,Nat.mod_lt _ (by decide)⟩
def physicalIndex (kind : HTKind) (j : Fin 14) : Fin 14 :=
  ⟨((if kind == .hat then 27 else 15)-j.val)%14,Nat.mod_lt _ (by decide)⟩
def rawPlacedVertex (p : HTPlacement) (j : Fin 14) : SpectreClusters.Point :=
  SpectreClusters.add (lattice p.center)
    (SpectreClusters.rotate p.turn ((htRefinedPolygon p.kind).getD j.val (0,0)))
def physicalPlacedVertex4 (big : Bool) (n : Nat) (j : Fin 14) : ExactPoint :=
  let p := (pieces big).getD n ⟨.turtle,0,(0,0)⟩
  ExactPoint.add ((origins big).getD n ((0,0),(0,0)))
    (sourceVertex4 (physicalTurn p) (physicalIndex p.kind j))

/-- Every literal piece vertex has one source-correct physical P value.
This is a finite pose and shared-vertex consistency fact, not a tiling claim. -/
theorem all_piece_vertex_values : ∀ big : Bool, ∀ n : Fin 9,
    n.val < (pieces big).length → ∀ j : Fin 14,
    vertexImage4 big (rawPlacedVertex ((pieces big).getD n.val ⟨.turtle,0,(0,0)⟩) j) =
      physicalPlacedVertex4 big n.val j := by
  intro big; cases big <;> decide

theorem vertexPairs_distinct : ∀ big : Bool, ((vertexPairs big).map Prod.fst).Nodup := by
  intro big; cases big <;> decide

theorem marked_boundary_in_vertexPairs : ∀ k : Fin 9, ∀ d : Fin 6,
    ∀ p ∈ (markedPaths k).getD d.val [], p ∈ (vertexPairs (k.val != 0)).map Prod.fst := by
  exact Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (Fin.cases (by decide) (fun i => Fin.elim0 i)))))))))

